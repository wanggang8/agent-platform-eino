{
  "name": "agent-platform-eino",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "web/eino-workbench"
  ],
  "scripts": {
    "eino-workbench:schema-test": "node scripts/eino_workbench_schema_validate.mjs",
    "eino-workbench:contract-generate": "node scripts/eino_workbench_contract_generate.mjs",
    "eino-workbench:contract-test": "node scripts/eino_workbench_schema_validate.mjs --contract && node scripts/eino_workbench_contract_generate.mjs --check",
    "eino-workbench:openapi-lint": "node scripts/eino_workbench_schema_validate.mjs --openapi",
    "eino-workbench:typecheck": "npm --workspace @agent-platform-eino/eino-workbench run typecheck",
    "eino-workbench:test": "npm --workspace @agent-platform-eino/eino-workbench run test",
    "eino-workbench:stream-test": "node scripts/eino_workbench_not_implemented.mjs stream-test Phase-3",
    "eino-workbench:browser-test": "node scripts/eino_workbench_not_implemented.mjs browser-test Phase-2",
    "eino-workbench:visual-test": "node scripts/eino_workbench_not_implemented.mjs visual-test Phase-2",
    "eino-workbench:build": "npm --workspace @agent-platform-eino/eino-workbench run build",
    "eino-workbench:send-smoke": "bash scripts/eino_workbench_server_smoke.sh --scenario contract"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.0.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20"
  }
}
