{
  "name": "agent-platform-eino",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "web/eino-workbench"
  ],
  "scripts": {
    "verify:toolchain": "bash scripts/verify_toolchain.sh",
    "test:toolchain": "bash scripts/verify_toolchain_test.sh",
    "build:toolchain-image": "bash scripts/build_toolchain_image.sh --load",
    "test:toolchain-image": "bash scripts/build_toolchain_image_test.sh",
    "validate:ci": "bash scripts/validate_ci_config.sh",
    "test:ci-config": "GOTOOLCHAIN=local go test ./scripts/validate_ci_config -count=1",
    "eino-workbench:schema-test": "node scripts/eino_workbench_schema_validate.mjs",
    "eino-workbench:contract-generate": "node scripts/eino_workbench_contract_generate.mjs",
    "eino-workbench:contract-test": "node scripts/eino_workbench_schema_validate.mjs --contract && node scripts/eino_workbench_contract_generate.mjs --check",
    "eino-workbench:openapi-lint": "node scripts/eino_workbench_schema_validate.mjs --openapi",
    "eino-workbench:typecheck": "npm --workspace @agent-platform-eino/eino-workbench run typecheck",
    "eino-workbench:test": "npm --workspace @agent-platform-eino/eino-workbench run test",
    "eino-workbench:browser-test": "npm --workspace @agent-platform-eino/eino-workbench run browser-test --",
    "eino-workbench:build": "npm --workspace @agent-platform-eino/eino-workbench run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "24.13.3",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": "24.18.0",
    "npm": "11.16.0"
  }
}
