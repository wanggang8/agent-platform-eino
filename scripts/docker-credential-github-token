#!/usr/bin/env bash
set -euo pipefail
LC_ALL=C

fail() {
  printf 'credential helper: %s\n' "$1" >&2
  exit 1
}

case ${1-} in
  get)
    # 使用尾部标记保留 stdin 的换行，确保只接受逐字一致的 registry 名称。
    server=$(cat; printf '\037')
    server=${server%$'\037'}
    [[ $server == ghcr.io ]] || fail 'server is not allowed'
    [[ -n ${GHCR_ACTOR-} && -n ${GHCR_TOKEN-} ]] || fail 'credentials are unavailable'
    [[ $GHCR_ACTOR =~ ^[A-Za-z0-9-]+$ ]] || fail 'credentials are invalid'
    # GitHub token 是不透明值；只拒绝 JSON/协议不安全的 ASCII 控制字符，不解析其格式。
    [[ ! $GHCR_TOKEN =~ [[:cntrl:]] ]] || fail 'token contains control characters'
    escaped_token=${GHCR_TOKEN//\\/\\\\}
    escaped_token=${escaped_token//\"/\\\"}
    # 凭据仅写入 Docker 当前请求的 stdout，反斜杠与双引号已做 JSON 安全转义。
    printf '{"Username":"%s","Secret":"%s"}\n' "$GHCR_ACTOR" "$escaped_token"
    ;;
  store|erase)
    # 显式拒绝 Docker 的持久化协议，避免 token 进入任何配置文件或 keychain。
    fail 'persistence is disabled'
    ;;
  list)
    printf '{}\n'
    ;;
  *)
    fail 'action is not supported'
    ;;
esac
