{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-platform-eino.local/schemas/skip-report.schema.json",
  "title": "Eino Workbench Skip Report",
  "type": "object",
  "required": ["schema_version", "command", "missing_env", "credential_scope", "reason", "rerun_condition", "blocks_claims", "expires_at"],
  "properties": {
    "schema_version": {"const": "eino.skip_report.v1"},
    "command": {"type": "string"},
    "missing_env": {"type": "array", "items": {"type": "string"}},
    "credential_scope": {"type": "string"},
    "reason": {"type": "string"},
    "rerun_condition": {"type": "string"},
    "blocks_claims": {"type": "array", "items": {"type": "string"}},
    "expires_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
