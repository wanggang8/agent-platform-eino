{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-platform-eino.local/schemas/eino_workbench_message_response.v1.schema.json",
  "title": "Eino Workbench Message Response",
  "type": "object",
  "required": ["schema_version", "run_id", "status", "stream_url"],
  "properties": {
    "schema_version": {"const": "eino_workbench_message_response.v1"},
    "run_id": {"type": "string"},
    "status": {"enum": ["accepted", "running", "waiting", "failed"]},
    "stream_url": {"type": "string"},
    "snapshot_url": {"type": "string"}
  },
  "additionalProperties": false
}
