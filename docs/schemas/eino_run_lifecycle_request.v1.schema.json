{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-platform-eino.local/schemas/eino_run_lifecycle_request.v1.schema.json",
  "title": "Eino Run Lifecycle Request",
  "type": "object",
  "required": ["schema_version", "action", "client_request_id"],
  "properties": {
    "schema_version": {"const": "eino_run_lifecycle_request.v1"},
    "action": {
      "type": "string",
      "enum": ["cancel", "stop", "provider_timeout", "pending_timeout", "budget_exceeded", "retry"]
    },
    "client_request_id": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
