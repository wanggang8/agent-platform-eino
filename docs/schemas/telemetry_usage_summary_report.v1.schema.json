{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-platform-eino.local/schemas/telemetry_usage_summary_report.v1.schema.json",
  "title": "Eino Telemetry Usage Summary Report",
  "type": "object",
  "required": ["schema_version", "report_kind", "generated_at", "summary", "blocks_claims"],
  "properties": {
    "schema_version": {"const": "eino.telemetry_usage_summary_report.v1"},
    "report_kind": {"const": "telemetry_usage_summary"},
    "generated_at": {"type": "string", "format": "date-time"},
    "summary": {
      "type": "object",
      "required": [
        "run_id",
        "workspace_id",
        "event_count",
        "model_call_count",
        "failure_count",
        "input_tokens",
        "output_tokens",
        "total_tokens",
        "estimated_cost_microunits",
        "total_latency_ms",
        "first_event_at",
        "last_event_at"
      ],
      "properties": {
        "run_id": {"type": "string"},
        "workspace_id": {"type": "string"},
        "event_count": {"type": "integer", "minimum": 0},
        "model_call_count": {"type": "integer", "minimum": 0},
        "failure_count": {"type": "integer", "minimum": 0},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0},
        "estimated_cost_microunits": {"type": "integer", "minimum": 0},
        "total_latency_ms": {"type": "integer", "minimum": 0},
        "first_event_at": {"type": "string", "format": "date-time"},
        "last_event_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "blocks_claims": {
      "type": "array",
      "maxItems": 0
    }
  },
  "additionalProperties": false
}
