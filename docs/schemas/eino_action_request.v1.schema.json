{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-platform-eino.local/schemas/eino_action_request.v1.schema.json",
  "title": "Eino Action Request",
  "type": "object",
  "required": ["schema_version", "action_id", "client_request_id", "input"],
  "properties": {
    "schema_version": {"const": "eino_action_request.v1"},
    "action_id": {"type": "string"},
    "client_request_id": {"type": "string"},
    "capability_hint": {"type": "string"},
    "input": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "attachments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["attachment_ref", "media_type"],
            "properties": {
              "attachment_ref": {"type": "string"},
              "media_type": {"type": "string"},
              "safe_name": {"type": "string"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "properties": {
        "timezone": {"type": "string"},
        "locale": {"type": "string"},
        "safe_user_label": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
