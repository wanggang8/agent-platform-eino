{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-platform-eino.local/schemas/eino_product_facts.v2.schema.json",
  "title": "M1 Product Facts",
  "type": "object",
  "required": ["schema_version", "workspace_id", "conversation_id", "actor_id", "run_id", "query_sequence", "status", "structured_result", "snapshot", "events"],
  "properties": {
    "schema_version": {"const": "eino_product_facts.v2"},
    "workspace_id": {"type": "string", "minLength": 1},
    "conversation_id": {"type": "string", "minLength": 1},
    "actor_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "query_sequence": {"type": "integer", "minimum": 1},
    "status": {"enum": ["succeeded", "failed"]},
    "structured_result": {
      "oneOf": [
        {"$ref": "tool.structured_result.v2.schema.json"},
        {"type": "null"}
      ]
    },
    "snapshot": {
      "oneOf": [
        {"$ref": "eino_query_result_snapshot.v2.schema.json"},
        {"type": "null"}
      ]
    },
    "safe_error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {"const": "fixture_read_failed"},
        "message": {"const": "无法读取漏洞事实。此次请求不是空结果。"}
      },
      "additionalProperties": false
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["event_id", "sequence", "type", "created_at"],
        "properties": {
          "event_id": {"type": "string", "minLength": 1},
          "sequence": {"type": "integer", "minimum": 1},
          "type": {"enum": ["query.succeeded", "query.failed"]},
          "created_at": {"type": "string", "format": "date-time"}
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "succeeded"}}, "required": ["status"]},
      "then": {"type": "object", "properties": {"structured_result": {"type": "object"}, "snapshot": {"type": "object"}}, "not": {"type": "object", "properties": {"safe_error": {"type": "object"}}, "required": ["safe_error"]}}
    },
    {
      "if": {"properties": {"status": {"const": "failed"}}, "required": ["status"]},
      "then": {"type": "object", "properties": {"structured_result": {"type": "null"}, "snapshot": {"type": "null"}, "safe_error": {"type": "object"}}, "required": ["safe_error"]}
    }
  ],
  "additionalProperties": false
}
