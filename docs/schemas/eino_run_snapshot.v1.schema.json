{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-platform-eino.local/schemas/eino_run_snapshot.v1.schema.json",
  "title": "Eino Run Snapshot",
  "type": "object",
  "required": ["schema_version", "workspace_id", "run_id", "status", "view", "audit_refs"],
  "properties": {
    "schema_version": {"const": "eino_run_snapshot.v1"},
    "workspace_id": {"type": "string"},
    "run_id": {"type": "string"},
    "status": {"enum": ["created", "running", "waiting", "succeeded", "failed", "cancelled", "stopped"]},
    "view": {"$ref": "eino_workbench_view.v1.schema.json"},
    "replay_url": {"type": "string"},
    "stream_url": {"type": "string"},
    "audit_refs": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
