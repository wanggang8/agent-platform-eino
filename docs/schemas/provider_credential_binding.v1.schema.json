{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-platform-eino.local/schemas/provider_credential_binding.v1.schema.json",
  "title": "Provider Credential Binding",
  "type": "object",
  "required": ["schema_version", "workspace_id", "system", "status", "display_ref"],
  "properties": {
    "schema_version": {"const": "eino.provider_credential_binding.v1"},
    "workspace_id": {"type": "string"},
    "system": {"enum": ["fobrain", "llm", "mcp", "local"]},
    "status": {"enum": ["configured", "missing", "unbound", "bound"]},
    "display_ref": {"type": "string", "pattern": "^(configured|missing|unbound|bound:[a-z0-9_-]+:[a-z0-9_-]+)$"},
    "owner_scope": {"enum": ["workspace", "caller", "system"]},
    "updated_at": {"type": "string", "format": "date-time"},
    "audit_ref": {"type": "string"}
  },
  "additionalProperties": false
}
