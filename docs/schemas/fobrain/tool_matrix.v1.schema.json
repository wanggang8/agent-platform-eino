{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-platform-eino.local/schemas/fobrain/tool_matrix.v1.schema.json",
  "title": "Fobrain Tool Matrix",
  "type": "object",
  "required": ["schema_version", "matrix_version", "tools"],
  "properties": {
    "schema_version": {"const": "fobrain.tool_matrix.v1"},
    "matrix_version": {"type": "string"},
    "tools": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": {"$ref": "#/$defs/tool"}
    }
  },
  "$defs": {
    "tool": {
      "type": "object",
      "required": [
        "tool_id",
        "display_name_zh",
        "input_schema_ref",
        "required_fields",
        "result_schema_ref",
        "batch_gate",
        "display_type",
        "entity_type",
        "result_status",
        "fixture",
        "real_model_prompt_id",
        "mock_assertions",
        "live_assertions",
        "screenshot_state",
        "sensitive_fields",
        "readonly_matrix"
      ],
      "properties": {
        "tool_id": {
          "enum": [
            "tool.fobrain.current_user_context",
            "tool.fobrain.my_permissions",
            "tool.fobrain.list_assets_by_owner",
            "tool.fobrain.list_vulnerabilities_by_owner",
            "tool.fobrain.list_assets_by_department",
            "tool.fobrain.list_vulnerabilities_by_department",
            "tool.fobrain.list_assets_by_ip",
            "tool.fobrain.list_vulnerabilities_by_ip",
            "tool.fobrain.get_asset_detail",
            "tool.fobrain.get_vulnerability_detail",
            "tool.fobrain.business_risk_summary",
            "tool.fobrain.business_list",
            "tool.fobrain.external_high_risk_assets",
            "tool.fobrain.threat_relevance_list",
            "tool.fobrain.vulnerability_status_summary",
            "tool.fobrain.pending_tickets",
            "tool.fobrain.ip_stats",
            "tool.fobrain.vul_stats",
            "tool.fobrain.my_assets",
            "tool.fobrain.my_department_assets",
            "tool.fobrain.my_vulnerabilities",
            "tool.fobrain.my_department_vulnerabilities",
            "tool.fobrain.my_business_systems",
            "tool.fobrain.my_important_business_systems"
          ]
        },
        "display_name_zh": {"type": "string"},
        "input_schema_ref": {"type": "string"},
        "required_fields": {"type": "array", "items": {"type": "string"}},
        "result_schema_ref": {"const": "docs/schemas/fobrain/tool_result.v2.schema.json"},
        "batch_gate": {"enum": ["A", "B", "C", "D", "E"]},
        "display_type": {"enum": ["entity_collection", "entity_detail", "metrics_summary", "connector_status", "operation_result", "entity_resolution"]},
        "entity_type": {"enum": ["asset", "vulnerability", "ticket", "business_system", "user", "permission", "risk", "connector", "entity"]},
        "result_status": {"enum": ["resolved", "waiting", "pending_approval", "not_found", "empty", "failed", "partial"]},
        "fixture": {"type": "string"},
        "real_model_prompt_id": {"type": "string"},
        "mock_assertions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "live_assertions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "screenshot_state": {"enum": ["collapsed", "expanded", "detail", "approval", "clarification"]},
        "sensitive_fields": {"type": "array", "items": {"type": "string"}},
        "readonly_matrix": {"const": true}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
