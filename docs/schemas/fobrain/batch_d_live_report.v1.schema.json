{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-platform-eino.local/schemas/fobrain/batch_d_live_report.v1.schema.json",
  "title": "Fobrain Batch D Live Report",
  "type": "object",
  "required": [
    "schema_version",
    "scenario",
    "status",
    "provider_mode",
    "workspace_id",
    "tls_private_cert_mode",
    "sample_inputs",
    "capability_results",
    "redaction_checks",
    "failure_category",
    "blocks_claims",
    "report_created_at"
  ],
  "properties": {
    "schema_version": {"const": "eino.fobrain_batch_d_live_report.v1"},
    "scenario": {"const": "fobrain-batch-d"},
    "status": {"enum": ["passed", "failed", "blocked"]},
    "provider_mode": {"const": "live"},
    "workspace_id": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]+$"},
    "tls_private_cert_mode": {"type": "boolean"},
    "sample_inputs": {
      "type": "object",
      "required": ["owner_present", "department_present", "ip_present"],
      "properties": {
        "owner_present": {"type": "boolean"},
        "department_present": {"type": "boolean"},
        "ip_present": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "capability_results": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "capability_id",
          "status",
          "structured_result_schema",
          "policy_decision",
          "failure_category",
          "sample_source"
        ],
        "properties": {
          "capability_id": {
            "enum": [
              "tool.fobrain.list_assets_by_owner",
              "tool.fobrain.list_vulnerabilities_by_owner",
              "tool.fobrain.list_assets_by_department",
              "tool.fobrain.list_vulnerabilities_by_department",
              "tool.fobrain.list_assets_by_ip",
              "tool.fobrain.list_vulnerabilities_by_ip"
            ]
          },
          "status": {"enum": ["passed", "failed", "blocked"]},
          "structured_result_schema": {"const": "tool.structured_result.v1"},
          "result_ref": {"type": "string", "pattern": "^result:[A-Za-z0-9_.:-]+$"},
          "policy_decision": {
            "enum": [
              "allowed",
              "credential_missing",
              "credential_scope_denied",
              "connector_transport_unavailable",
              "connector_execution_failed",
              "connector_timeout",
              "connector_auth_failure",
              "permission_denied"
            ]
          },
          "failure_category": {"type": "string"},
          "sample_source": {"enum": ["provided", "current_user", "missing"]}
        },
        "additionalProperties": false
      }
    },
    "redaction_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "secret_absent",
          "auth_header_absent",
          "raw_payload_absent",
          "binding_reference_absent",
          "checkpoint_absent",
          "interrupt_absent"
        ]
      }
    },
    "failure_category": {"type": "string"},
    "blocks_claims": {"type": "array", "items": {"type": "string"}},
    "report_created_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "properties": {
        "capability_results": {
          "allOf": [
            {
              "type": "array",
              "contains": {
                "type": "object",
                "properties": {"capability_id": {"const": "tool.fobrain.list_assets_by_owner"}},
                "required": ["capability_id"]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "type": "array",
              "contains": {
                "type": "object",
                "properties": {"capability_id": {"const": "tool.fobrain.list_vulnerabilities_by_owner"}},
                "required": ["capability_id"]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "type": "array",
              "contains": {
                "type": "object",
                "properties": {"capability_id": {"const": "tool.fobrain.list_assets_by_department"}},
                "required": ["capability_id"]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "type": "array",
              "contains": {
                "type": "object",
                "properties": {"capability_id": {"const": "tool.fobrain.list_vulnerabilities_by_department"}},
                "required": ["capability_id"]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "type": "array",
              "contains": {
                "type": "object",
                "properties": {"capability_id": {"const": "tool.fobrain.list_assets_by_ip"}},
                "required": ["capability_id"]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "type": "array",
              "contains": {
                "type": "object",
                "properties": {"capability_id": {"const": "tool.fobrain.list_vulnerabilities_by_ip"}},
                "required": ["capability_id"]
              },
              "minContains": 1,
              "maxContains": 1
            }
          ]
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "passed"}}, "required": ["status"]},
      "then": {
        "properties": {
          "failure_category": {"const": "none"},
          "blocks_claims": {"type": "array", "maxItems": 0},
          "sample_inputs": {
            "type": "object",
            "properties": {
              "owner_present": {"type": "boolean", "const": true},
              "department_present": {"type": "boolean", "const": true},
              "ip_present": {"type": "boolean", "const": true}
            },
            "required": ["owner_present", "department_present", "ip_present"]
          },
          "capability_results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "status": {"type": "string", "const": "passed"},
                "result_ref": {"type": "string", "pattern": "^result:[A-Za-z0-9_.:-]+$"},
                "policy_decision": {"type": "string", "const": "allowed"},
                "failure_category": {"type": "string", "const": "none"},
                "sample_source": {"type": "string", "enum": ["provided", "current_user"]}
              },
              "required": ["result_ref"]
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"status": {"enum": ["failed", "blocked"]}}, "required": ["status"]},
      "then": {
        "properties": {
          "blocks_claims": {"type": "array", "minItems": 1}
        }
      }
    }
  ],
  "additionalProperties": false
}
