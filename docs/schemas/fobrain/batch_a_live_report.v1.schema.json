{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-platform-eino.local/schemas/fobrain/batch_a_live_report.v1.schema.json",
  "title": "Fobrain Batch A Live Report",
  "type": "object",
  "required": [
    "schema_version",
    "scenario",
    "status",
    "provider_mode",
    "workspace_id",
    "tls_private_cert_mode",
    "capability_results",
    "redaction_checks",
    "failure_category",
    "report_created_at"
  ],
  "properties": {
    "schema_version": {"const": "eino.fobrain_batch_a_live_report.v1"},
    "scenario": {"const": "fobrain-batch-a"},
    "status": {"enum": ["passed", "failed"]},
    "provider_mode": {"const": "live"},
    "workspace_id": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]+$"},
    "tls_private_cert_mode": {"type": "boolean"},
    "capability_results": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "capability_id",
          "status",
          "structured_result_schema",
          "policy_decision",
          "failure_category"
        ],
        "properties": {
          "capability_id": {
            "enum": [
              "connector.fobrain.security",
              "tool.fobrain.current_user_context",
              "tool.fobrain.my_permissions"
            ]
          },
          "status": {"enum": ["passed", "failed"]},
          "structured_result_schema": {"const": "tool.structured_result.v1"},
          "result_ref": {"type": "string", "pattern": "^result:[A-Za-z0-9_.:-]+$"},
          "safe_summary": {"type": "string", "minLength": 1},
          "policy_decision": {
            "enum": [
              "allowed",
              "credential_missing",
              "credential_scope_denied",
              "connector_transport_unavailable",
              "connector_execution_failed",
              "connector_timeout",
              "connector_auth_failure",
              "permission_denied"
            ]
          },
          "failure_category": {"type": "string"}
        },
        "additionalProperties": false
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": ["capability_id"],
            "properties": {
              "capability_id": {"const": "connector.fobrain.security"}
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["capability_id"],
            "properties": {
              "capability_id": {"const": "tool.fobrain.current_user_context"}
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["capability_id"],
            "properties": {
              "capability_id": {"const": "tool.fobrain.my_permissions"}
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "redaction_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "secret_absent",
          "auth_header_absent",
          "raw_payload_absent",
          "binding_reference_absent",
          "checkpoint_absent",
          "interrupt_absent"
        ]
      }
    },
    "failure_category": {"type": "string"},
    "blocks_claims": {"type": "array", "items": {"type": "string"}},
    "report_created_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "passed"}}, "required": ["status"]},
      "then": {
        "properties": {
          "failure_category": {"const": "none"},
          "capability_results": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["result_ref", "safe_summary"],
              "properties": {
                "status": {"const": "passed"},
                "failure_category": {"const": "none"},
                "result_ref": {"type": "string", "pattern": "^result:[A-Za-z0-9_.:-]+$"},
                "safe_summary": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
