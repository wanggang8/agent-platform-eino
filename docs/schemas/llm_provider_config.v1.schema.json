{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-platform-eino.local/schemas/llm_provider_config.v1.schema.json",
  "title": "LLM Provider Config",
  "type": "object",
  "required": ["schema_version", "provider", "base_url", "model"],
  "properties": {
    "schema_version": {"const": "eino.llm_provider_config.v1"},
    "provider": {"enum": ["mock", "openai_compatible", "openai", "azure_openai", "custom"]},
    "base_url": {"type": "string", "format": "uri"},
    "api_key": {"type": "string"},
    "model": {"type": "string"},
    "timeout": {"type": "string", "pattern": "^[0-9]+(ms|s|m|h)$"}
  },
  "additionalProperties": false
}
