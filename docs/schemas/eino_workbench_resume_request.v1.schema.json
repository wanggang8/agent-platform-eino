{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-platform-eino.local/schemas/eino_workbench_resume_request.v1.schema.json",
  "title": "Eino Workbench Resume Request",
  "type": "object",
  "required": ["schema_version", "resume_ref", "client_request_id"],
  "properties": {
    "schema_version": {"const": "eino_workbench_resume_request.v1"},
    "resume_ref": {"type": "string"},
    "client_request_id": {"type": "string"},
    "decision": {"enum": ["approve", "reject", "cancel"]},
    "selected_candidate_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "free_text": {"type": "string", "minLength": 1},
    "comment": {"type": "string"}
  },
  "oneOf": [
    {
      "title": "Decision resume",
      "properties": {
        "decision": true,
        "selected_candidate_refs": false,
        "free_text": false
      },
      "required": ["decision"]
    },
    {
      "title": "Clarification candidate resume",
      "properties": {
        "decision": false,
        "selected_candidate_refs": true,
        "free_text": false
      },
      "required": ["selected_candidate_refs"]
    },
    {
      "title": "Clarification free text resume",
      "properties": {
        "decision": false,
        "selected_candidate_refs": false,
        "free_text": true
      },
      "required": ["free_text"]
    },
    {
      "title": "Clarification mixed resume",
      "properties": {
        "decision": false,
        "selected_candidate_refs": true,
        "free_text": true
      },
      "required": ["selected_candidate_refs", "free_text"]
    }
  ],
  "additionalProperties": false
}
