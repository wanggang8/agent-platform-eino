{
  "name": "@agent-platform-eino/eino-workbench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8081",
    "schema-test": "node ../../scripts/eino_workbench_schema_validate.mjs",
    "contract-generate": "node ../../scripts/eino_workbench_contract_generate.mjs",
    "contract-test": "node ../../scripts/eino_workbench_schema_validate.mjs --contract && node ../../scripts/eino_workbench_contract_generate.mjs --check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "stream-test": "node ../../scripts/eino_workbench_stream_test.mjs",
    "browser-test": "bash ../../scripts/m1_browser_test.sh",
    "build": "tsc --noEmit -p tsconfig.json && vite build"
  },
  "engines": {
    "node": "24.18.0",
    "npm": "11.16.0"
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "^1.1.14",
    "@radix-ui/react-scroll-area": "^1.2.12",
    "@radix-ui/react-tabs": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@tanstack/react-query": "^5.101.2",
    "lucide-react": "^1.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  }
}
